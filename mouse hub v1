-- FREECAM
local freecamConn, fcInputConn, fcPart
local CursorLocked = true
local originalAnchorState = false

local function StopFreecam()
	if freecamConn then freecamConn:Disconnect() freecamConn = nil end
	if fcInputConn then fcInputConn:Disconnect() fcInputConn = nil end
	if fcPart then fcPart:Destroy() fcPart = nil end
	Camera.CameraType = Enum.CameraType.Custom
	UIS.MouseBehavior = Enum.MouseBehavior.Default
	local char = LocalPlayer.Character
	if char then
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hrp then hrp.Anchored = originalAnchorState end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then Camera.CameraSubject = hum end
	end
end

local function StartFreecam()
	StopFreecam()
	if not FreecamEnabled or not Active then return end
	fcPart = Instance.new("Part", workspace)
	fcPart.Anchored, fcPart.CanCollide, fcPart.Transparency = true, false, 1
	fcPart.CFrame = Camera.CFrame
	Camera.CameraType = Enum.CameraType.Scriptable
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then originalAnchorState = hrp.Anchored; hrp.Anchored = true end
	CursorLocked = true
	local lookVec = Camera.CFrame.LookVector
	local yaw = math.atan2(-lookVec.X, -lookVec.Z)
	local pitch = math.asin(math.clamp(lookVec.Y, -1, 1))

	fcInputConn = UIS.InputBegan:Connect(function(input, gp)
		if not gp and input.KeyCode == Enum.KeyCode.V then CursorLocked = not CursorLocked end
	end)

	freecamConn = RunService.RenderStepped:Connect(function(dt)
		if not FreecamEnabled or not Active then StopFreecam() return end
		if CursorLocked then
			UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
			local delta = UIS:GetMouseDelta()
			yaw = yaw - math.rad(delta.X * 0.25)
			pitch = math.clamp(pitch - math.rad(delta.Y * 0.25), -math.pi / 2 + 0.01, math.pi / 2 - 0.01)
		else UIS.MouseBehavior = Enum.MouseBehavior.Default end

		local cf = CFrame.new(fcPart.Position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
		local moveDir = Vector3.zero
		if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir += cf.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir -= cf.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir -= cf.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir += cf.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.yAxis end
		if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir -= Vector3.yAxis end

		if moveDir.Magnitude > 0 then
			fcPart.CFrame = CFrame.new(fcPart.Position + moveDir.Unit * (FreecamSpeed * dt)) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
		else fcPart.CFrame = cf end
		Camera.CFrame = fcPart.CFrame
	end)
end

local function ToggleFreecam(state)
	FreecamEnabled = state
	if FreecamEnabled then StartFreecam() else StopFreecam() end
	SaveAllSettings()
end

-- NOCLIP
local noclipConnection
local function ToggleNoclip(state)
	NoclipEnabled = state
	if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
	if NoclipEnabled then
		noclipConnection = RunService.Stepped:Connect(function()
			local char = LocalPlayer.Character
			if char then
				for _, part in ipairs(char:GetChildren()) do
					if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end
				end
			end
		end)
		TrackConn(noclipConnection)
	end
	SaveAllSettings()
end

-- ANTI FLING
local trackedPlayers = {}
local function BuildCache(player)
	if player == LocalPlayer or not player.Character then return end
	local parts = {}
	for _, part in ipairs(player.Character:GetDescendants()) do if part:IsA("BasePart") then parts[#parts + 1] = part end end
	trackedPlayers[player] = parts
	TrackConn(player.Character.DescendantAdded:Connect(function(part)
		if part:IsA("BasePart") then local cache = trackedPlayers[player] if cache then cache[#cache + 1] = part end end
	end))
	TrackConn(player.Character.AncestryChanged:Connect(function(_, parent) if not parent then trackedPlayers[player] = nil end end))
end

for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then BuildCache(p) TrackConn(p.CharacterAdded:Connect(function() task.wait() BuildCache(p) end)) end end
TrackConn(Players.PlayerAdded:Connect(function(p) TrackConn(p.CharacterAdded:Connect(function() task.wait() BuildCache(p) end)) end))

TrackConn(RunService.Stepped:Connect(function()
	if not AntiFlingEnabled or not Active then return end
	for player, parts in pairs(trackedPlayers) do
		if player.Character and player.Character.Parent then
			for _, part in ipairs(parts) do if part.CanCollide then part.CanCollide = false end end
		end
	end
end))

-- FLY
local flyConnection, bVelocity, bGyro
local function ToggleFly(state)
	FlyEnabled = state
	if flyConnection then flyConnection:Disconnect() flyConnection = nil end
	if bVelocity then bVelocity:Destroy() bVelocity = nil end
	if bGyro then bGyro:Destroy() bGyro = nil end
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then hum.PlatformStand = false end

	if FlyEnabled then
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp or not hum then return end
		hum.PlatformStand = true
		bGyro = Instance.new("BodyGyro", hrp)
		bGyro.P = 9e4; bGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9); bGyro.cframe = hrp.CFrame
		bVelocity = Instance.new("BodyVelocity", hrp)
		bVelocity.velocity = Vector3.new(0, 0.1, 0); bVelocity.maxForce = Vector3.new(9e9, 9e9, 9e9)
		flyConnection = RunService.RenderStepped:Connect(function()
			if not FlyEnabled or not Active or not hrp.Parent or not hum.Parent then return ToggleFly(false) end
			bGyro.cframe = Camera.CFrame
			local flyVelocity = hum.MoveDirection * FlySpeed
			if UIS:IsKeyDown(Enum.KeyCode.Space) or (UIS.TouchEnabled and hum.Jump) then flyVelocity += Vector3.new(0, FlySpeed, 0) end
			if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then flyVelocity -= Vector3.new(0, FlySpeed, 0) end
			bVelocity.velocity = flyVelocity
		end)
		TrackConn(flyConnection)
	end
	SaveAllSettings()
end

