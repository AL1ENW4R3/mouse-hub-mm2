local ZOOM_BIND_NAME = "MinimalZoomOverride"
local function SetZoom(min, max)
	LocalPlayer.CameraMinZoomDistance = min
	LocalPlayer.CameraMaxZoomDistance = max
end

local function EnableInfiniteZoom()
	pcall(function() RunService:UnbindFromRenderStep(ZOOM_BIND_NAME) end)
	RunService:BindToRenderStep(ZOOM_BIND_NAME, Enum.RenderPriority.Camera.Value + 1, function()
		if not InfiniteZoomEnabled or not Active then
			pcall(function() RunService:UnbindFromRenderStep(ZOOM_BIND_NAME) end)
