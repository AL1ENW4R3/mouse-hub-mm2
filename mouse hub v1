local Pages = {}
local TabButtons = {}

local function SwitchTab(pageName)
	for name, page in pairs(Pages) do page.Visible = (name == pageName) end
	for name, btn in pairs(TabButtons) do
		btn.BackgroundColor3 = (name == pageName) and Color3.fromRGB(40, 40, 44) or Color3.fromRGB(28, 28, 30)
		btn.TextColor3 = (name == pageName) and Color3.fromRGB(230, 230, 240) or Color3.fromRGB(150, 150, 160)
		btn:FindFirstChild("UIStroke").Enabled = (name == pageName)
	end
end

local function MakePage(name)
	local btn = Instance.new("TextButton", tabBar)
	btn.Size = UDim2.new(0, 100, 0, 28)
	btn.BackgroundColor3 = Color3.fromRGB(28, 28, 30); btn.TextColor3 = Color3.fromRGB(150, 150, 160)
	btn.Font = Enum.Font.GothamBold; btn.TextSize = 12; btn.Text = name
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
	local stroke = Instance.new("UIStroke", btn)
	stroke.Color = GetThemeColor(); stroke.Thickness = 1.5
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; stroke.Enabled = false
	table.insert(ThemeColorElements, {inst = stroke, prop = "Color"})
	TabButtons[name] = btn

	local page = Instance.new("ScrollingFrame", contentRoot)
	page.ScrollBarThickness = 4; page.CanvasSize = UDim2.new(0, 0, 0, 0)
	page.AutomaticCanvasSize = Enum.AutomaticSize.Y; page.ScrollingDirection = Enum.ScrollingDirection.Y
	page.Size = UDim2.new(1, 0, 1, 0); page.BackgroundTransparency = 1; page.Visible = false

	local list = Instance.new("UIListLayout", page)
	list.FillDirection = Enum.FillDirection.Vertical; list.SortOrder = Enum.SortOrder.LayoutOrder; list.Padding = UDim.new(0, 8)
	local pad = Instance.new("UIPadding", page); pad.PaddingTop = UDim.new(0, 4); pad.PaddingBottom = UDim.new(0, 4)

	list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		page.CanvasSize = UDim2.new(0, 0, 0, list.AbsoluteContentSize.Y + 16)
	end)

	Pages[name] = page
	btn.Activated:Connect(function() SwitchTab(name) end)
	return page
end

