local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RoleCache = {}

task.spawn(function()
	while task.wait(0.5) do
		if not Active then break end
		pcall(function()
			local data = ReplicatedStorage:FindFirstChild("GetPlayerData", true):InvokeServer()
			if data then
				local newCache = {}
				for plrName, plrData in pairs(data) do
					if type(plrData) == "table" and not plrData.Dead then newCache[plrName] = plrData.Role end
				end
				RoleCache = newCache
			end
		end)
	end
end)

local function GetPlayerRole(player) return player and RoleCache[player.Name] or "Innocent" end

local function GetMurdererV1()
	for _, p in pairs(Players:GetPlayers()) do
		if RoleCache[p.Name] == "Murderer" then return p, p.Character end
	end
	return nil, nil
end

local function GetSheriffV1()
	for _, p in pairs(Players:GetPlayers()) do
		if RoleCache[p.Name] == "Sheriff" or RoleCache[p.Name] == "Hero" then return p, p.Character end
	end
	return nil, nil
end

local function GetRoleColor(char)
	local player = Players:GetPlayerFromCharacter(char)
	if not player then return Color3.fromHSV(InnocentHue / 360, 1, 1) end
	local role = GetPlayerRole(player)
	if RoleESPEnabled then
		if role == "Murderer" then return Color3.fromHSV(MurdererHue / 360, 1, 1) end
		if role == "Sheriff" or role == "Hero" then return Color3.fromHSV(SheriffHue / 360, 1, 1) end
	end
	return Color3.fromHSV(InnocentHue / 360, 1, 1)
end

local function ApplyChams(char, color)
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hrp then hrp.LocalTransparencyModifier = 1 end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") and part ~= hrp and part.Transparency >= 1 then part.Transparency = 0.99 end
	end
	local existing = char:FindFirstChild("ChamsESP")
	if existing then
		existing.FillColor = color; existing.OutlineColor = color
		existing.FillTransparency = EspFillTransparency / 100
		return
	end
	local h = Instance.new("Highlight")
	h.Name = "ChamsESP"; h.FillTransparency = EspFillTransparency / 100; h.OutlineTransparency = 0.25
	h.FillColor = color; h.OutlineColor = color; h.Parent = char
end

local function UpdateAllPlayerChams()
	if not ChamsESPEnabled then return end
	for _, player in pairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then ApplyChams(player.Character, GetRoleColor(player.Character)) end
	end
end

local function RemoveChamsESP()
	for _, player in pairs(Players:GetPlayers()) do
		if player.Character then
			local esp = player.Character:FindFirstChild("ChamsESP")
			if esp then esp:Destroy() end
			local hrp = player.Character:FindFirstChild("HumanoidRootPart")
			if hrp then hrp.LocalTransparencyModifier = 0 end
		end
	end
end

-- GUN ESP
local ActiveGunESPInstances = {}
local function CreateGunESP(gun)
	if not GunESPEnabled or gun:FindFirstChild("GunESP") then return end
	local highlight = Instance.new("Highlight", gun)
	highlight.Name = "GunESP"; highlight.FillColor = Color3.fromHSV(GunHue / 360, 1, 1)
	highlight.OutlineColor = highlight.FillColor; highlight.FillTransparency = GunEspFillTransparency / 100
	highlight.OutlineTransparency = 0.2
	local billboard = Instance.new("BillboardGui", gun)
	billboard.Name = "GunESP"; billboard.Size = UDim2.new(0, 120, 0, 20); billboard.StudsOffset = Vector3.new(0, 2, 0)
	billboard.AlwaysOnTop = true; billboard.Enabled = GunTextESPEnabled
	local text = Instance.new("TextLabel", billboard)
	text.Size = UDim2.new(1, 0, 1, 0); text.BackgroundTransparency = 1
	text.Text = "Gun Drop"; text.TextColor3 = Color3.fromRGB(210, 190, 255)
	text.Font = Enum.Font.GothamBold; text.TextScaled = true
	table.insert(ActiveGunESPInstances, highlight); table.insert(ActiveGunESPInstances, billboard)
end

local function UpdateAllGunObjects()
	for _, v in pairs(ActiveGunESPInstances) do
		if v and v.Parent then
			if v:IsA("Highlight") then
				v.FillColor = Color3.fromHSV(GunHue / 360, 1, 1)
				v.FillTransparency = GunEspFillTransparency / 100
				v.OutlineColor = v.FillColor
			elseif v:IsA("BillboardGui") then v.Enabled = GunTextESPEnabled end
		end
	end
end

local function RemoveGunESP()
	for _, v in pairs(ActiveGunESPInstances) do if v and v.Parent then v:Destroy() end end
	table.clear(ActiveGunESPInstances)
end

TrackConn(workspace.DescendantAdded:Connect(function(obj)
	if obj.Name == "GunDrop" and obj:IsA("BasePart") then
		if GunESPEnabled then CreateGunESP(obj) end
		if AutoGrabGunEnabled then
			local char = LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp then
				local originalCFrame = hrp.CFrame
				task.wait(0.05)
				hrp.CFrame = obj.CFrame + Vector3.new(0, 1.5, 0)
				task.delay(0.25, function() if hrp then hrp.CFrame = originalCFrame end end)
			end
		end
	end
end))

-- XRAY
local xrayCache = {}
local xrayConn
local function IsPlayerPart(part)
	for _, p in pairs(Players:GetPlayers()) do if p.Character and part:IsDescendantOf(p.Character) then return true end end
	return false
end

local function ApplyXrayToPart(part)
	if not part:IsA("BasePart") or IsPlayerPart(part) then return end
	if xrayCache[part] == nil then xrayCache[part] = part.LocalTransparencyModifier end
	part.LocalTransparencyModifier = 0.65
end

local function EnableXray()
	for _, v in pairs(workspace:GetDescendants()) do ApplyXrayToPart(v) end
	if xrayConn then xrayConn:Disconnect() end
	xrayConn = workspace.DescendantAdded:Connect(ApplyXrayToPart)
	TrackConn(xrayConn)
end

local function DisableXray()
	if xrayConn then xrayConn:Disconnect() xrayConn = nil end
	for part, old in pairs(xrayCache) do if part and part.Parent then part.LocalTransparencyModifier = old end end
	xrayCache = {}
end

